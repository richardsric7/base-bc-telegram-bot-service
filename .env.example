# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to operate the bot
ALLOWED_TELEGRAM_IDS=123456789

# Base RPC endpoint. Defaults to the public Base Sepolia RPC.
BASE_RPC_URL=https://sepolia.base.org

# "sepolia" (default, safe for testing) or "mainnet"
CHAIN_NETWORK=sepolia

# Passphrase used to encrypt wallet private keys at rest (AES-256-GCM via
# scrypt). Required, at least 16 characters. Keep this secret and back it up
# separately from the database file — losing it makes stored wallets
# unrecoverable.
WALLET_ENCRYPTION_KEY=

# Uniswap V3 SwapRouter02-compatible router address on Base (used for
# /swap_execute). Example (Base mainnet Uniswap SwapRouter02):
# 0x2626664c2603336E57B271c5C0b26F421741e481
DEX_ROUTER_ADDRESS=

# Matching QuoterV2 address, used for /swap_quote. Example (Base mainnet):
# 0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a
DEX_QUOTER_ADDRESS=

# WETH9 address on Base, used to represent native ETH in swap paths.
# Base mainnet: 0x4200000000000000000000000000000000000006
WETH_ADDRESS=

# Path to the SQLite database file
DATABASE_PATH=./data/bot.db

# Safety cap: reject any single transaction that sends more than this many
# ETH as msg.value. 0 disables the cap.
MAX_TX_VALUE_ETH=1.0
